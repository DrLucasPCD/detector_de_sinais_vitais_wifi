# API local. Para expor na LAN, troque RF_HTTP_HOST e defina RF_API_TOKEN.
RF_HTTP_HOST=127.0.0.1
RF_HTTP_PORT=8000

# Receptor CSI.
RF_UDP_HOST=0.0.0.0
RF_UDP_PORT=5005
RF_ALLOWED_SENDERS=127.0.0.1

# O simulador atravessa o mesmo socket UDP usado pela placa.
RF_SIMULATOR=1
RF_SIMULATOR_SCENARIO=cycle
RF_SIMULATOR_SEED=42

# A ficha técnica exige pelo menos 600 quadros para a baseline.
RF_CALIBRATION_FRAMES=600
RF_STALE_AFTER_SECONDS=10

# Obrigatório quando RF_HTTP_HOST não for loopback.
RF_API_TOKEN=

# Mapa e malha. Copie o exemplo e ajuste as medidas/nós reais.
RF_ENVIRONMENT_FILE=config/environment.example.json

# HomeKit direto por HAP local (não usa Home Assistant).
RF_HOMEKIT_ENABLED=0
RF_HOMEKIT_PORT=51826
RF_HOMEKIT_PIN=031-45-154
RF_HOMEKIT_PERSIST_FILE=.rf-sense-homekit.state

# Alexa direta: RF Sense -> AWS IoT Thing Shadow -> Lambda/Skill.
RF_ALEXA_IOT_ENABLED=0
RF_AWS_IOT_ENDPOINT=
RF_AWS_IOT_THING_NAME=rf-sense-local
RF_AWS_IOT_CERT=
RF_AWS_IOT_KEY=
RF_AWS_IOT_CA=

# Home Assistant independente por MQTT Discovery.
RF_HOME_ASSISTANT_ENABLED=0
RF_MQTT_HOST=
RF_MQTT_PORT=1883
RF_MQTT_USERNAME=
RF_MQTT_PASSWORD=
RF_MQTT_TLS=0
RF_MQTT_DISCOVERY_PREFIX=homeassistant
