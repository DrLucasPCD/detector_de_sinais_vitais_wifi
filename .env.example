# API local. Para expor na LAN, troque RF_HTTP_HOST e defina RF_API_TOKEN.
RF_HTTP_HOST=127.0.0.1
RF_HTTP_PORT=8000

# Receptor CSI.
RF_UDP_HOST=0.0.0.0
RF_UDP_PORT=5005
RF_ALLOWED_SENDERS=127.0.0.1

# O simulador atravessa o mesmo socket UDP usado pela placa.
RF_SIMULATOR=1
RF_SIMULATOR_SCENARIO=cycle
RF_SIMULATOR_SEED=42

# A ficha técnica exige pelo menos 600 quadros para a baseline.
RF_CALIBRATION_FRAMES=600
RF_STALE_AFTER_SECONDS=10

# Obrigatório quando RF_HTTP_HOST não for loopback.
RF_API_TOKEN=

